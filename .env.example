# Configuración de Elastic APM (fase F6). Copiar este archivo como .env y completar.
# .env está en .gitignore: las credenciales nunca se suben al repositorio.
#
# Sin ELASTIC_APM_SERVER_URL el agente queda desactivado y la app funciona igual.

# Endpoint de APM del proyecto Observability en Elastic Cloud
# (Add data > Application > Elastic APM > Python).
ELASTIC_APM_SERVER_URL=

# API key del proyecto (Elastic Cloud Serverless usa API keys en lugar de secret token).
ELASTIC_APM_API_KEY=

# Opcional: separa en Kibana las corridas de cada integrante o de la defensa oral.
ELASTIC_APM_ENVIRONMENT=desarrollo
